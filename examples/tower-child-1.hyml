master: examples/tower.hyml

def:
  - template: apartment
    content:
      div:
        p: "Motel Room Unit"
    master-overwrite: true
  - var: test
    type: number
    value: 21
  - var: page_title
    type: string
    value: "This is the Child 1 Page Title"
  - var: message
    type: string
    value: Holi

title:
  value: $var(page_title)
  overwrite:
    type: append

content-placeholder-resolver:
  name: main-area
  content:
    p: $var(message)